# Local development outside Docker: copy to .env. Hosts are reached via 127.0.0.1
# because Docker Desktop's IPv6 forward for `localhost` can hang on Windows.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DATABASE_URL=postgres://ccp:ccp@127.0.0.1:5433/simulator
REDIS_URL=redis://127.0.0.1:6379/1
# Must match the platform's SIMULATOR_API_KEY / SIMULATOR_WEBHOOK_SECRET.
SIMULATOR_API_KEY=dev-simulator-api-key
SIMULATOR_WEBHOOK_SECRET=dev-simulator-webhook-secret
# Optional demo tuning (defaults shown): delay range per lifecycle step, and the share of
# webhooks sent twice or held back so they arrive out of order.
# LIFECYCLE_MIN_DELAY_SECONDS=1.0
# LIFECYCLE_MAX_DELAY_SECONDS=4.0
# WEBHOOK_DUPLICATE_RATE=0.1
# WEBHOOK_OUT_OF_ORDER_RATE=0.1
