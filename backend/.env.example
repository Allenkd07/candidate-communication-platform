# Local development outside Docker: copy to .env. Hosts are reached via 127.0.0.1
# because Docker Desktop's IPv6 forward for `localhost` can hang on Windows.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DATABASE_URL=postgres://ccp:ccp@127.0.0.1:5433/ccp
REDIS_URL=redis://127.0.0.1:6379/0
