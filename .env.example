# docker compose settings: copy to .env. Hosts are compose service names.
POSTGRES_USER=ccp
POSTGRES_PASSWORD=ccp
POSTGRES_DB=ccp

API_DATABASE_URL=postgres://ccp:ccp@postgres:5432/ccp
API_REDIS_URL=redis://redis:6379/0
SIMULATOR_DATABASE_URL=postgres://ccp:ccp@postgres:5432/simulator
SIMULATOR_REDIS_URL=redis://redis:6379/1

# Origin the frontend server proxies /api/* to (baked in at build time).
FRONTEND_API_ORIGIN=http://api:8000

# Host ports; change if one is already taken.
FRONTEND_PORT=3000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
