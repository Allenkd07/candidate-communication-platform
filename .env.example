# docker compose settings: copy to .env. Hosts are compose service names.
POSTGRES_USER=ccp
POSTGRES_PASSWORD=ccp
POSTGRES_DB=ccp

API_DATABASE_URL=postgres://ccp:ccp@postgres:5432/ccp
API_REDIS_URL=redis://redis:6379/0
SIMULATOR_DATABASE_URL=postgres://ccp:ccp@postgres:5432/simulator
SIMULATOR_REDIS_URL=redis://redis:6379/1

# Platform -> simulator calls and simulator -> platform webhooks. SHARED_* values are
# used by both the API and the simulator.
API_WEBHOOK_BASE_URL=http://api:8000
API_SIMULATOR_URL=http://provider-simulator:8001
SHARED_SIMULATOR_API_KEY=dev-simulator-api-key
SHARED_SIMULATOR_WEBHOOK_SECRET=dev-simulator-webhook-secret

# Origin the frontend server proxies /api/* to (baked in at build time).
FRONTEND_API_ORIGIN=http://api:8000

# Host ports; change if one is already taken.
FRONTEND_PORT=3000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

# Production only (docker-compose.prod.yml). Every secret must be a long random value.
APP_DOMAIN=candidates.example.com
SIMULATOR_DOMAIN=sms-sim.example.com
API_DJANGO_SECRET_KEY=
SIMULATOR_DJANGO_SECRET_KEY=
